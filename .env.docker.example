# Variables de entorno para Docker Compose
# COPIA ESTE ARCHIVO A .env.docker Y REEMPLAZA LOS VALORES CON PRODUCCIóN
# =====================================

# Base de Datos MySQL
MYSQL_ROOT_PASSWORD=changeme_produccion
MYSQL_DATABASE=rm_metalurgica
MYSQL_USER=rm_app
MYSQL_PASSWORD=changeme_produccion

# Backend Node.js
DB_HOST=database
DB_PORT=3306
DB_USER=rm_app
DB_PASSWORD=changeme_produccion
DB_NAME=rm_metalurgica

# JWT Configuration
JWT_SECRET=changeme_con_openssl_rand_-hex_32
JWT_EXPIRATION=7d
JWT_COOKIE_EXPIRATION=7

# General
NODE_ENV=production
CORS_ORIGIN=https://tu-dominio.com
PORT=4000
